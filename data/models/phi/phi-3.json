{
  "name": "Phi-3",
  "slug": "phi-3",
  "releaseDate": "2024-04-23",
  "developer": "Microsoft Research",
  "license": "MIT",
  "modelType": "BASE",
  "baseModel": "phi-2",

  "tags": ["official", "text-generation", "vision", "long-context", "on-device", "open-source"],

  "benchmarks": {
    "mmlu": 69.0,
    "humaneval": 58.5,
    "gpqa": 29.2,
    "custom": {
      "hellaswag": 77.4,
      "arc-c": 85.7,
      "mt-bench": 8.38
    },
    "source": "https://arxiv.org/abs/2404.14219"
  },

  "description": {
    "ja": "2024年4月公開（Microsoft Build 2024）。初の商用対応SLM。mini（3.8B）、small（7B）、medium（14B）、vision（4.2B）の4サイズ展開。SFT、DPO、RLHFで安全性強化。スマートフォン上で実行可能。Phi-3-miniはMixtral 8x7B、GPT-3.5に匹敵。",
    "en": "Released April 2024 (Microsoft Build 2024). First commercial SLM. Four sizes: mini (3.8B), small (7B), medium (14B), vision (4.2B). Enhanced safety via SFT, DPO, RLHF. Runnable on smartphones. Phi-3-mini rivals Mixtral 8x7B and GPT-3.5."
  },

  "specs": {
    "contextLength": 128000,
    "trainingTokens": "3.3T (mini), 4.8T (small/medium)",
    "knowledgeCutoff": "2024-Q1",
    "languages": ["en"],
    "architecture": "Dense decoder-only Transformer, SFT + DPO + RLHF",
    "promptTemplate": {
      "format": "phi-3",
      "system": "<|system|>\n{system_prompt}<|end|>",
      "user": "<|user|>\n{user_message}<|end|>",
      "assistant": "<|assistant|>\n{assistant_response}<|end|>",
      "stopTokens": ["<|end|>", "<|endoftext|>"]
    }
  },

  "links": {
    "huggingface": "https://huggingface.co/microsoft",
    "paper": "https://arxiv.org/abs/2404.14219",
    "website": "https://azure.microsoft.com/en-us/blog/introducing-phi-3-redefining-whats-possible-with-slms/"
  },

