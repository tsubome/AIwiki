  "license": "Apache 2.0",
  "modelType": "INSTRUCT",

  "tags": ["official", "bilingual", "dialogue"],

  "description": {
    "ja": "ChatGLM-6Bの第2世代。FlashAttentionによる長文対応（32Kトークン）、大幅な性能向上を実現。1.4兆トークンで学習。MMLUで+23%、GSM8Kで+571%の性能向上。",
    "en": "Second generation of ChatGLM-6B. Features FlashAttention for long context (32K tokens) and significant performance improvements. Trained on 1.4T tokens. +23% on MMLU, +571% on GSM8K."
  },

  "benchmarks": {
    "mmlu": 45.2,
    "source": "ChatGLM2 Technical Report"
  },

  "specs": {
    "contextLength": 32768,
    "trainingTokens": "1.4T",
    "languages": ["zh", "en"],
    "architecture": "GLM Transformer with FlashAttention",
    "promptTemplate": {
      "format": "chatglm2",
      "user": "[Round {n}]\n\n问：{prompt}\n\n",
      "assistant": "答：",
      "stopTokens": ["</s>"]
    }
  },

  "links": {
