{
  "name": "ChatGLM-6B",
  "slug": "chatglm-6b",
  "releaseDate": "2023-03-14",
  "developer": "Zhipu AI / Tsinghua University",
  "license": "Apache 2.0",
  "modelType": "INSTRUCT",

  "tags": ["official", "bilingual", "dialogue"],

  "description": {
    "ja": "コンシューマー向けGPUで動作可能な初のGLM対話モデル。INT4量子化で6GB VRAMで推論可能。中国語・英語のバイリンガル対応。GLM-130Bの技術を小型化し、ローカル実行を実現。",
    "en": "The first GLM dialogue model runnable on consumer GPUs. Inference possible with 6GB VRAM using INT4 quantization. Bilingual support for Chinese and English. Miniaturized GLM-130B technology enabling local execution."
  },

  "benchmarks": {
    "mmlu": 25.2,
    "source": "ChatGLM Technical Report"
  },

  "specs": {
    "contextLength": 2048,
    "languages": ["zh", "en"],
    "architecture": "GLM Transformer",
    "promptTemplate": {
      "format": "chatglm",
      "user": "[Round {n}]\n问：{prompt}\n",
      "assistant": "答：",
      "stopTokens": ["</s>"]
    }
  },

  "links": {
    "github": "https://github.com/THUDM/ChatGLM-6B",
    "huggingface": "https://huggingface.co/THUDM/chatglm-6b"
  },

