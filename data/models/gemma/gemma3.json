{
  "name": "Gemma 3",
  "slug": "gemma3",
  "releaseDate": "2025-03-12",
  "developer": "Google DeepMind",
  "license": "Gemma Terms of Use",
  "modelType": "BASE",
  "baseModel": "gemma2",

  "tags": ["official", "text-generation", "vision", "multilingual", "long-context", "instruction-tuned"],

  "benchmarks": {
    "mmlu": 76.9,
    "mmlupro": 67.5,
    "gpqa": 42.4,
    "humaneval": 87.8,
    "math": 69.0,
    "custom": {
      "mmmu": 64.9,
      "lmarena-elo": 1338
    },
    "source": "https://arxiv.org/abs/2503.19786"
  },

  "description": {
    "ja": "2025年3月12日公開。128Kコンテキスト（4B以上）、140+言語対応。SigLIP Vision Encoder（896x896）搭載でマルチモーダル対応（4B以上）。5:1 Local-to-Global Attention、QAT対応チェックポイント提供。LMArena Elo 1338達成。",
    "en": "Released March 12, 2025. 128K context (4B+), 140+ language support. Multimodal capability (4B+) via SigLIP Vision Encoder (896x896). Features 5:1 Local-to-Global Attention ratio and QAT checkpoints. Achieved LMArena Elo 1338."
  },

  "specs": {
    "contextLength": 128000,
    "knowledgeCutoff": "2025-Q1",
    "languages": ["en", "zh", "ja", "ko", "de", "fr", "es", "pt", "it", "ru", "ar", "hi", "th", "vi", "id"],
    "architecture": "Decoder-only Transformer, 5:1 Local-to-Global Attention, RoPE (base freq 1M), SigLIP Vision Encoder, Pan & Scan, Bidirectional attention for images, QAT, Vocab 256K",
    "promptTemplate": {
      "format": "gemma3",
      "user": "<start_of_turn>user\n{user_message}<end_of_turn>",
      "assistant": "<start_of_turn>model\n{assistant_response}<end_of_turn>",
      "stopTokens": ["<end_of_turn>", "<eos>"]
    }
  },

  "links": {
    "huggingface": "https://huggingface.co/collections/google/gemma-3",
    "paper": "https://arxiv.org/abs/2503.19786",
    "github": "https://github.com/google-deepmind/gemma",
    "website": "https://ai.google.dev/gemma/docs/core"
  },

