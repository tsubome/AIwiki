generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model LLMModel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parameters  String?
  releaseDate DateTime?
  developer   String?
  license     String?
  huggingface String?

  // Family tree relationships
  parentId    String?
  parent      LLMModel?  @relation("ModelLineage", fields: [parentId], references: [id])
  children    LLMModel[] @relation("ModelLineage")

  // Model type: BASE, FINETUNE, MERGE, QUANTIZED
  modelType   String @default("BASE")

  // GGUF files
  ggufFiles   GGUFFile[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GGUFFile {
  id          String   @id @default(cuid())
  name        String
  size        String?
  url         String
  modelId     String
  model       LLMModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  recommended Boolean  @default(false)
}
